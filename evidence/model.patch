++	// entries take this same one-token lock; Puts do not, so they continue.
++	select {
++	case db.internal.syncLockC <- struct{}{}:
++	case <-db.internal.closeC:
++		return errClosed
++	}
++	defer func() { <-db.internal.syncLockC }()
