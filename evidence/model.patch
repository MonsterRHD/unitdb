++// remainingTTL is the store ttl of a promoted message with expiry expiresAt:
++// "" for one that never expires.
++func remainingTTL(expiresAt int64) string {
++	if expiresAt == 0 {
++		return ""
++	}
++	secs := expiresAt - time.Now().Unix()
++	if secs < 1 {
++		secs = 1
++	}
++	return strconv.FormatInt(secs, 10)
++}
