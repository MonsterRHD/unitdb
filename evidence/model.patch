++func txnTopicName() string {
++	n := atomic.AddInt32(&txnTestTopic, 1)
++	return "txn.test.topic." + itoa32(n)
++}
++
++func itoa32(n int32) string {
++	if n == 0 {
++		return "0"
++	}
++	var b [12]byte
++	pos := len(b)
++	for n > 0 {
++		pos--
++		b[pos] = byte('0' + n%10)
++		n /= 10
++	}
++	return string(b[pos:])
++}
