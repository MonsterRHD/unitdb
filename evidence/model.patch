++func corruptByte(t *testing.T, path string, off int64) {
++	t.Helper()
++	f, err := os.OpenFile(path, os.O_RDWR, 0)
++	if err != nil {
++		t.Fatal(err)
++	}
++	fi, err := f.Stat()
++	if err != nil {
++		t.Fatal(err)
++	}
++	if fi.Size() <= off {
++		off = fi.Size() - 1
++	}
++	buf := []byte{0}
++	if _, err := f.ReadAt(buf, off); err != nil {
++		t.Fatal(err)
++	}
++	buf[0] ^= 0xff
++	if _, err := f.WriteAt(buf, off); err != nil {
++		t.Fatal(err)
++	}
++	if err := f.Close(); err != nil {
++		t.Fatal(err)
++	}
++}
