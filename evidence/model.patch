++	legacies := make(chan bool, 2)
++	for i := 0; i < 2; i++ {
++		wg.Add(1)
++		go func() {
++			defer wg.Done()
++			l, e := c.runBatchPublish(pub, msgs)
++			legacies <- l
++			errs <- e
