++func txnValidated(topic, payload string) *validatedMsg {
++	pm := &utp.PublishMessage{Topic: topic, Payload: []byte(payload), Ttl: ""}
++	return &validatedMsg{msg: pm, topic: security.ParseKey(topic)}
++}
