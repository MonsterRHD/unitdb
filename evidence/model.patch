++	manifestFiles := make([]backupFile, 0, len(files))
++	dirs := make(map[string]bool)
++	for _, f := range files {
++		copied, err := copyTracked(f.src, f.dst, f.isLog)
++		if err != nil {
++			return err
++		}
++		copied.name = f.name
++		manifestFiles = append(manifestFiles, copied)
++		dirs[filepath.Dir(f.dst)] = true
++	}
