+	// The later writes belong to the source only.
+	got = backupMessages(t, db, topic, 0)
+	if len(got) != 100 {
+		t.Fatalf("source expected 100 messages; got %d", len(got))
+	}
+	if err := db.Close(); err != nil {
+		t.Fatal(err)
+	}
+}
