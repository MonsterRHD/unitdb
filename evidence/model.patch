++	s.stop()
++	s.server = startServerWith(t, serverOpts{
++		cluster:  c.conf(nil, nil),
++		args:     []string{"-cluster_self", "two"},
++		tcpAddr:  tcp,
++		grpcAddr: grpc,
++		dbPath:   db,
