++func assertHistoryLen(t *testing.T, contract uint32, topic string, want int) {
++	t.Helper()
++	msgs, err := store.Message.GetAll(contract, topic, "")
++	if err != nil {
++		t.Fatal(err)
++	}
++	if len(msgs) != want {
++		t.Fatalf("GetAll(%q): %d messages, want %d", topic, len(msgs), want)
++	}
++}
